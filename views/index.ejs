<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Open Fire – Battle Royale Game</title>
</head>

<body>
  <%- include('header') %>

  <!-- Hero Section -->
  <div class="bg-white">
    <div class="relative isolate px-6 pt-14 lg:px-8">
      <div aria-hidden="true"
        class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
        <div
          style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
          class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75">
        </div>
      </div>

      <div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-36 text-center">
        <div class="hidden sm:mb-8 sm:flex sm:justify-center">
          <div
            class="relative rounded-full px-3 py-1 text-sm/6 text-gray-600 ring-1 ring-gray-900/10 hover:ring-gray-900/20">
            Experience one of the most intense Battle Royale games of 2026!
          </div>
        </div>
        <h1 class="text-5xl font-semibold tracking-tight text-gray-900 sm:text-7xl">Dive Into Open Fire – Battle to Survive!</h1>
        <p class="mt-8 font-medium text-gray-500">
          Join millions of players worldwide in fast-paced matches, unlock epic skins, and dominate the battlefield.
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a href="#explore" class="btn1">Play Now</a>
          <a href="#about" class="text-sm/6 font-semibold text-gray-900">Learn More <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>

  <!-- Game Highlight Section -->
  <div class="relative w-full h-[500px] bg-[url('/images/bg%20image.jpg')] bg-cover bg-center bg-fixed">
    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/50"></div>

    <!-- Text and Button -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white">
      <h2 class="text-5xl font-extrabold mb-4">Your Gaming Adventure Awaits</h2>
      <p class="mb-6">Gear up, strategize, and survive in the ultimate Battle Royale experience.</p>
      <a href="#explore" class="px-6 py-3 bg-yellow-500 hover:bg-yellow-600 text-black font-semibold rounded-lg shadow-lg transition">
        Explore Now
      </a>
    </div>
  </div>

  <!-- Stats Section -->
  <section class="flex flex-col md:flex-row w-[95%] mx-auto my-20 bg-[#101828] text-white rounded-lg overflow-hidden shadow-lg">
    <!-- Left Image -->
    <div class="md:w-1/2 w-full px-12 py-32 flex flex-col justify-center">
      <span class="text-blue-400 uppercase text-sm mb-2">Game Highlights</span>
      <h2 class="text-4xl font-bold mb-4">Trusted by Thousands of Players Worldwide</h2>
      <p class="text-gray-300 mb-6">
        Open Fire offers unmatched gameplay, thrilling matches, and constant updates to keep the action fresh and exciting.
      </p>

      <!-- Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 gap-6 mt-4">
        <div>
          <h3 class="text-2xl font-bold">5M+</h3>
          <p class="text-gray-400">Active Players</p>
        </div>
        <div>
          <h3 class="text-2xl font-bold">100+</h3>
          <p class="text-gray-400">Maps & Arenas</p>
        </div>
        <div>
          <h3 class="text-2xl font-bold">500+</h3>
          <p class="text-gray-400">Daily Matches</p>
        </div>
        <div>
          <h3 class="text-2xl font-bold">24/7</h3>
          <p class="text-gray-400">Support Availability</p>
        </div>
      </div>
      <button class="bg-yellow-600 p-2 mt-[20px] w-[200px] cursor-pointer rounded-[10px]">Contact Us</button>
    </div>

    <!-- Right Content -->
    <div class="md:w-1/2 w-full">
      <img src="/images/bg image.jpg" class="w-full h-full object-cover" alt="Team playing Open Fire">
    </div>
    
  </section>

  <!--FAQ-->
  <section class="flex flex-col md:flex-row w-[95%] mx-auto my-20 py-6 gap-10">
    <!-- Left Image -->
    <div class="md:w-1/2 bg-[url('/images/FAQ.jpg')] bg-cover bg-center rounded-lg shadow-lg"></div>

    <!-- FAQ Content -->
    <div class="space-y-4 md:w-1/2">
      <h2 class="text-3xl font-bold mb-4">Frequently Asked Questions</h2>
      <p class="text-gray-500 mb-6">
        Got questions? We've got answers! Learn more about Open Fire, gameplay, and getting started.
      </p>

      <!-- FAQ Item 1 -->
      <div class="border rounded-lg overflow-hidden shadow hover:shadow-lg transition-shadow">
        <button class="w-full px-6 py-4 text-left flex justify-between items-center focus:outline-none faq-btn">
          <span class="font-medium text-lg">What is Open Fire?</span>
          <span class="transform transition-transform duration-300">-</span>
        </button>
        <div class="px-6 py-4 faq-content">
          Open Fire is a fast-paced Battle Royale game where players fight to survive in a dynamic arena, unlocking weapons, skins, and rewards along the way.
        </div>
      </div>

      <!-- FAQ Item 2 -->
      <div class="border rounded-lg overflow-hidden shadow hover:shadow-lg transition-shadow">
        <button class="w-full px-6 py-4 text-left flex justify-between items-center focus:outline-none faq-btn">
          <span class="font-medium text-lg">How can I start playing?</span>
          <span class="transform transition-transform duration-300">+</span>
        </button>
        <div class="px-6 py-4 hidden faq-content">
          Simply create an account, download the game, and jump into your first match. Tutorials are available for beginners.
        </div>
      </div>

      <!-- FAQ Item 3 -->
      <div class="border rounded-lg overflow-hidden shadow hover:shadow-lg transition-shadow">
        <button class="w-full px-6 py-4 text-left flex justify-between items-center focus:outline-none faq-btn">
          <span class="font-medium text-lg">Is Open Fire free to play?</span>
          <span class="transform transition-transform duration-300">+</span>
        </button>
        <div class="px-6 py-4 hidden faq-content">
          Yes! Open Fire is free to play on all supported devices. In-game purchases are optional and cosmetic only.
        </div>
      </div>

      <!-- FAQ Item 4 -->
      <div class="border rounded-lg overflow-hidden shadow hover:shadow-lg transition-shadow">
        <button class="w-full px-6 py-4 text-left flex justify-between items-center focus:outline-none faq-btn">
          <span class="font-medium text-lg">Can I play with friends?</span>
          <span class="transform transition-transform duration-300">+</span>
        </button>
        <div class="px-6 py-4 hidden faq-content">
          Absolutely! Invite friends to your squad and coordinate strategies in team matches for ultimate victory.
        </div>
      </div>

      <!-- FAQ Item 5 -->
      <div class="border rounded-lg overflow-hidden shadow hover:shadow-lg transition-shadow">
        <button class="w-full px-6 py-4 text-left flex justify-between items-center focus:outline-none faq-btn">
          <span class="font-medium text-lg">What devices support Open Fire?</span>
          <span class="transform transition-transform duration-300">+</span>
        </button>
        <div class="px-6 py-4 hidden faq-content">
          Open Fire is available on PC, mobile, and console platforms. Check system requirements for the best experience.
        </div>
      </div>
    </div>
  </section>

  <div class="isolate bg-gray-900 px-6 py-24 sm:py-32 lg:px-8">
  <div aria-hidden="true" class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
    <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" class="relative left-1/2 -z-10 aspect-1155/678 w-144.5 max-w-none -translate-x-1/2 rotate-30 bg-linear-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-40rem)] sm:w-288.75"></div>
  </div>
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-4xl font-semibold tracking-tight text-balance text-white sm:text-5xl">Reach Us 
      Out
    </h2>
    <p class="mt-2 text-lg/8 text-gray-400">We are always here for Gamers</p>
  </div>
  
  <form action="/contact_us" method="POST" class="p-[40px] mx-auto mt-10 max-w-xl sm:mt-10 border-2 border-white">
    <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
      
      <div class="sm:col-span-2">
        <label for="name" class="block text-sm/6 font-semibold text-white">Name</label>
        <div class="mt-2.5">
          <input id="name" type="text" name="name" autocomplete="given-name" class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500" />
        </div>
      </div>

      <div class="sm:col-span-2">
        <label for="email" class="block text-sm/6 font-semibold text-white">Email</label>
        <div class="mt-2.5">
          <input id="email" type="email" name="email" autocomplete="email" class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500" />
        </div>
      </div>

      <div class="sm:col-span-2">
        <label for="phone-number" class="block text-sm/6 font-semibold text-white">Phone number</label>
        <div class="mt-2.5">
          <div class="flex rounded-md bg-white/5 outline-1 -outline-offset-1 outline-white/10 has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-indigo-500">
            <div class="grid shrink-0 grid-cols-1 focus-within:relative">
              <select id="country" name="country" autocomplete="country" aria-label="Country" class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-transparent py-2 pr-7 pl-3.5 text-base text-gray-400 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6">
                <option>IN</option>
                <option>US</option>
                <option>EU</option>
              </select>
              <svg viewBox="0 0 16 16" fill="currentColor" data-slot="icon" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-gray-400 sm:size-4">
                <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
              </svg>
            </div>
            <input id="phone-number" type="text" name="phone" placeholder="+91 12345-67890" class="block min-w-0 grow bg-transparent py-1.5 pr-3 pl-1 text-base text-white placeholder:text-gray-500 focus:outline-none sm:text-sm/6" />
          </div>
        </div>
      </div>

      <div class="sm:col-span-2">
        <label for="message" class="block text-sm/6 font-semibold text-white">Message</label>
        <div class="mt-2.5">
          <textarea id="message" name="message" rows="4" class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500"></textarea>
        </div>
      </div>

      <div class="flex gap-x-4 sm:col-span-2">
        <div class="flex h-6 items-center">
          <div class="group relative inline-flex w-8 shrink-0 rounded-full bg-white/5 p-px inset-ring inset-ring-white/10 outline-offset-2 outline-indigo-500 transition-colors duration-200 ease-in-out has-checked:bg-indigo-500 has-focus-visible:outline-2">
            <span class="size-4 rounded-full bg-white shadow-xs ring-1 ring-gray-900/5 transition-transform duration-200 ease-in-out group-has-checked:translate-x-3.5"></span>
            <input id="agree-to-policies" type="checkbox" name="agree-to-policies" aria-label="Agree to policies" class="absolute inset-0 appearance-none focus:outline-hidden" />
          </div>
        </div>
        <label for="agree-to-policies" class="text-sm/6 text-gray-400">
          By selecting this, you agree to our
          <a href="#" class="font-semibold whitespace-nowrap text-indigo-400">privacy policy</a>.
        </label>
      </div>

    </div>
    <div class="mt-10">
      <button type="submit" class="block w-full rounded-md bg-indigo-500 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">Let's talk</button>
    </div>
    <!-- Success Message -->
    <div id="succ" class="text-center pt-5 text-green-400 hidden">
    <p>Data has been Submitted Successfully</p>
    </div>

  </form>

</div>


  <%- include('footer') %>


</body>
</html>
